FROM node:22.23.4-bookworm-slim
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# Start: nginx fronts the three apps (see DEPLOYMENT.md §1/§4).
# Render injects $PORT and routes web traffic to it, while nginx.conf
# listens on the fixed port 5000 that docker-compose publishes. When
# $PORT is set (Render), rewrite the single `listen 5000;` directive to
# $PORT before starting nginx; when it is unset (local compose), the
# config is left untouched and behaviour is identical to before.
CMD ["sh", "-c", "if [ -n \"$PORT\" ]; then sed -i \"s/listen 5000;/listen $PORT;/\" /etc/nginx/nginx.conf; fi && nginx && pnpm run pm2"]
